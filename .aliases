# >> My .aliases <<

# Startup
alias pw='startplasma-wayland'

# Utilitários
alias beep='play -q -n synth 0.1 sin 1000'
alias cx='wl-copy'
alias cxx='wl-copy <'
alias v='vim'
alias ncspot='flatpak run io.github.hrkfdn.ncspot'
alias note='flatpak run md.obsidian.Obsidian'
alias ccp='copypath'
alias ex='extract'
alias kcl='kdeconnect-cli'

# Navegação e arquivos
alias md='mkdir -pv'
alias ..='z ..'
alias zi='z -i'
alias ls='eza --group-directories-first --icons=always'
alias la='eza -a --group-directories-first --icons=always'
alias ll='eza -l --group-directories-first --icons=always'
alias lla='eza -la --group-directories-first --icons=always'
alias lt='eza -T --group-directories-first --icons=always'
alias cat='bat'
alias c='clear'
alias x='exit'
alias d='systemd-run --user dolphin "$PWD" >/dev/null 2>&1'

# Python
alias py='python3'
alias cv='python3 -m venv .venv'
alias av='source .venv/bin/activate'
alias dv='deactivate'
alias rv='rm -rf .venv'
alias ppl='pip list'
alias pin='pip install'
alias pun='pip uninstall'
alias pf='pip freeze >'

# Git
alias gi='git init'
alias gcl='git clone'
alias gdd='git add'
alias gcm='git commit -m'
alias gp='git push'
alias gst='git status'
alias gl='git log'
alias gla='git log --all --oneline'
alias gb='git branch'
alias gsw='git switch'
alias gco='git checkout'
alias gmg='git merge'
